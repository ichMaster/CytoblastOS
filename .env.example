# CytoblastOS v0 prototype — copy to .env and fill in. .env is gitignored.

# Required. Your Anthropic API key.
ANTHROPIC_API_KEY=

# Optional. The model used for read paths, which in v0.1 is every path.
# Read paths run on the cheap fast tier (ARCHITECTURE §Trust modes); the
# cheap/strong routing rule is formally decided in v1.5.
# Defaults to claude-haiku-4-5 when unset.
CYTO_MODEL_READ=
